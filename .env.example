APP_ENV=development
APP_NAME=MoneyBeeLoans API
BUILD_SHA=development
MIGRATION_HEAD=unknown

DATABASE_URL=postgresql+asyncpg://moneybee:moneybee@localhost:5432/moneybee
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

KEYCLOAK_ISSUER=https://auth.codestra.co/realms/codestra
KEYCLOAK_AUDIENCE=moneybee-api
KEYCLOAK_JWKS_URL=https://auth.codestra.co/realms/codestra/protocol/openid-connect/certs

# MUST REMAIN FALSE DURING IMPLEMENTATION
CREDIT_LIVE_PULL=false
LENDERS_LIVE_SUBMISSION=false
ESIGN_LIVE_SEND=false
FUNDING_LIVE_CONFIRMATION=false
PAYMENTS_ENABLED=false
PAYOUTS_ENABLED=false
