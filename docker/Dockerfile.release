# syntax=docker/dockerfile:1.7

ARG PYTHON_BASE_IMAGE
FROM ${PYTHON_BASE_IMAGE} AS wheel

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1
WORKDIR /build

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY app ./app
# Keep bootstrap tooling and the transitive msgpack runtime above the fixed
# security floors enforced by the release scanner. Explicit requirements make
# these wheels available to the offline runtime installation below.
RUN python -m pip wheel --wheel-dir /wheels \
        "setuptools>=78.1.1" \
        "msgpack>=1.2.1" \
        .

FROM ${PYTHON_BASE_IMAGE} AS runtime

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app

RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*
# The base image's global copies are outside the application venv and are not
# runtime dependencies. Remove them so fixed packages in /opt/venv are the only
# copies present and whole-filesystem scanning remains meaningful.
RUN python -m venv /opt/venv \
    && python -m pip uninstall --yes setuptools msgpack \
    && addgroup --system moneybee \
    && adduser --system --ingroup moneybee --home /nonexistent --no-create-home moneybee

COPY --from=wheel /wheels /wheels
# The wheel stage has already resolved and built the complete transitive
# dependency set, including the exact Git-pinned Codestra SDK. Install only
# those local artifacts without re-resolving the backend wheel's direct URL
# metadata; then prove the resulting environment is internally consistent.
RUN /opt/venv/bin/python -m pip install \
        --no-cache-dir \
        --no-index \
        --no-deps \
        /wheels/*.whl \
    && /opt/venv/bin/python -m pip check \
    && rm -rf /wheels

COPY alembic.ini ./alembic.ini
COPY migrations ./migrations

USER moneybee

FROM runtime AS api
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]

FROM runtime AS worker
CMD ["python", "-m", "app.worker"]

FROM runtime AS migrate
CMD ["alembic", "upgrade", "head"]
