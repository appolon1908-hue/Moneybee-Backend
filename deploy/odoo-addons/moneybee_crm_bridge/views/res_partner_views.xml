<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="partner_form_moneybee" model="ir.ui.view">
    <field name="name">res.partner.form.moneybee</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="MoneyBee">
          <group>
            <field name="moneybee_business_lead_id" readonly="1"/>
            <field name="moneybee_contact_lead_id" readonly="1"/>
            <field name="moneybee_application_id" readonly="1"/>
            <field name="moneybee_last_sync_at" readonly="1"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>

