<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="crm_lead_form_moneybee" model="ir.ui.view">
    <field name="name">crm.lead.form.moneybee</field>
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="MoneyBee">
          <group>
            <field name="moneybee_lead_id" readonly="1"/>
            <field name="moneybee_application_id" readonly="1"/>
            <field name="moneybee_status" readonly="1"/>
            <field name="moneybee_risk_status" readonly="1"/>
            <field name="moneybee_use_of_funds" readonly="1"/>
            <field name="moneybee_source" readonly="1"/>
            <field name="moneybee_landing_page" readonly="1"/>
            <field name="moneybee_last_sync_at" readonly="1"/>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>

